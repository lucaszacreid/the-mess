---
import Base from '../layouts/Base.astro';
import CoffeeBarSketch from '../components/CoffeeBarSketch.astro';
import MenuBoard from '../components/MenuBoard.astro';
import { business, signTime } from '../data/business';
import { offerings } from '../data/offerings';
import { address, hours, ids, departmentLd, menuLd } from '../data/schema';

// Search: written for people looking for a coffee shop in Glasgow's West End.
const title = "THE MESS | Coffee Shop & Concept Store, Glasgow West End";
const description =
  'Speciality coffee and artisan pastries, curated interiors, reformer pilates and wellbeing under one roof. 37 Otago Street, Glasgow G12 8JJ. Open daily 8am–6pm.';
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const ogImage = `${site}/og.jpg`;
const { email, phoneHref } = business;
const { directions, instagram, googleProfile } = business.links;
const opensSign = signTime(business.hours.opens);
const closesSign = signTime(business.hours.closes);
const { website: websiteId, business: bizId } = ids(site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: `${site}/`,
      name: business.brand,
      alternateName: business.name,
      inLanguage: 'en-GB',
      publisher: { '@id': bizId },
    },
    {
      '@type': 'WebPage',
      '@id': `${site}/#webpage`,
      url: `${site}/`,
      name: title,
      description,
      inLanguage: 'en-GB',
      isPartOf: { '@id': websiteId },
      about: { '@id': bizId },
      primaryImageOfPage: ogImage,
    },
    {
      '@type': ['CafeOrCoffeeShop', 'LocalBusiness'],
      '@id': bizId,
      name: business.name,
      alternateName: [business.brand, 'The Mess Glasgow'],
      slogan: 'Coffee, Interiors, Wellbeing',
      description:
        "A concept store in Glasgow's West End bringing together speciality coffee and artisan pastries, curated homeware and interior design services, reformer pilates and wellbeing, including reiki.",
      url: `${site}/`,
      image: [ogImage],
      logo: `${site}/logo.png`,
      telephone: phoneHref,
      email,
      address,
      geo: { '@type': 'GeoCoordinates', latitude: business.lat, longitude: business.lng },
      hasMap: directions,
      areaServed: ['Hillhead', 'West End, Glasgow', 'Glasgow'],
      openingHoursSpecification: hours,
      foundingDate: business.openedOn,
      priceRange: '££',
      currenciesAccepted: 'GBP',
      servesCuisine: ['Coffee', 'Pastries'],
      hasMenu: { '@id': ids(site).menu },
      acceptsReservations: false,
      keywords: 'coffee shop, speciality coffee, cafe, pastries, concept store, interiors, homeware, interior design, reformer pilates, wellbeing, reiki, West End, Glasgow',
      sameAs: [instagram, googleProfile].filter(Boolean),
      department: offerings.filter((o) => o.schemaType).map((o) => departmentLd(site, o)),
    },
    menuLd(site),
  ],
};
---
<Base title={title} description={description} path="/" jsonLd={jsonLd}>
      <section class="hero" id="top" aria-label="Introduction">
        <h1 class="hero-mark">
          <span class="wordmark">THE MESS</span>
          <span class="submark">Concept Store</span>
        </h1>
        <span class="divider" aria-hidden="true"></span>
        <nav class="tagline" aria-label="Explore">
          <a href="/coffee/">Coffee</a><span class="sep" aria-hidden="true">-</span><a href="/interiors/">Interiors</a><span class="sep sep-mid" aria-hidden="true">-</span><a href="/pilates/">Pilates</a><span class="sep" aria-hidden="true">-</span><a href="/wellness/">Wellbeing</a>
        </nav>
        <p class="open-now">
          <span class="open-dot" aria-hidden="true"></span>Now open daily <time datetime={business.hours.opens}>{opensSign}</time> – <time datetime={business.hours.closes}>{closesSign}</time>
        </p>
        <span class="scroll-cue" aria-hidden="true"></span>
      </section>

      <section class="sketch-section" aria-label="The coffee bar">
        <div class="reveal draw">
          <CoffeeBarSketch />
        </div>
      </section>

      <section class="section" id="about" aria-labelledby="about-title">
        <div class="reveal">
          <h2 class="eyebrow" id="about-title">About</h2>
          <p class="lede">
            A unique concept store bringing together reformer pilates, speciality coffee and food,
            curated homeware, interior design services and wellbeing, including reiki.
          </p>
        </div>
      </section>

      <MenuBoard />
</Base>
