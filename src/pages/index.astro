---
import '@fontsource/inter/latin-700.css';
import '@fontsource/jost/latin-300.css';
import '@fontsource/jost/latin-400.css';
import 'lenis/dist/lenis.css';
import '../styles/global.css';

const title = 'THE MESS — Coffee, Interiors & Wellbeing · Glasgow';
const description = 'THE MESS — Coffee, interiors & wellbeing. 37 Otago Street, Glasgow G12 8JJ';
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const ogImage = `${site}/og.jpg`;
const year = new Date().getFullYear();
const directions = 'https://www.google.com/maps/search/?api=1&query=37+Otago+Street+Glasgow+G12+8JJ';
const instagram = 'https://www.instagram.com/themessconcept/';
const email = 'hello@themessconcept.co.uk';
const phone = '+44 7856 050231';
const phoneHref = '+447856050231';

const nav = [
  ['about', 'About'],
  ['coffee', 'Coffee'],
  ['interiors', 'Interiors'],
  ['pilates', 'Pilates'],
  ['wellness', 'Wellness'],
  ['opening-times', 'Opening Times'],
  ['visit', 'Visit'],
];

const offerings = [
  { id: 'coffee', title: 'Coffee', copy: 'Speciality coffee, served alongside artisan pastries.' },
  { id: 'interiors', title: 'Interiors', copy: 'Furniture, objects and homeware sourced from around the world, in limited quantities. Interior design services available.' },
  { id: 'pilates', title: 'Pilates', copy: 'Small mat and reformer classes, guided with care.' },
  { id: 'wellness', title: 'Wellness', copy: 'Quiet treatments and sessions to restore and reset.' },
];

const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['CafeOrCoffeeShop', 'LocalBusiness'],
  name: 'THE MESS',
  legalName: 'The Mess Concept',
  description,
  url: site + '/',
  image: ogImage,
  servesCuisine: 'Coffee',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '37 Otago Street',
    addressLocality: 'Glasgow',
    postalCode: 'G12 8JJ',
    addressCountry: 'GB',
  },
  hasMap: directions,
  email,
  telephone: phoneHref,
  sameAs: [instagram],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: days,
      opens: '08:00',
      closes: '18:00',
    },
  ],
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="canonical" href={site + '/'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="THE MESS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site + '/'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="THE MESS wordmark" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header" id="site-header">
      <div class="header-bar">
        <a class="wordmark" href="#top" aria-label="THE MESS, back to top">THE MESS</a>
        <button
          class="menu-toggle"
          id="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="menu"
          aria-label="Open menu"
        >
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>

      <nav class="menu" id="menu" aria-label="Main" inert>
        <ul>
          {nav.map(([id, label]) => (
            <li><a href={`#${id}`}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-label="Introduction">
        <div class="hero-mark">
          <h1 class="wordmark">THE MESS</h1>
          <p class="submark">Concept Store</p>
        </div>
        <span class="divider" aria-hidden="true"></span>
        <nav class="tagline" aria-label="Explore">
          <a href="#coffee">Coffee</a><span class="sep" aria-hidden="true">-</span><a href="#interiors">Interiors</a><span class="sep sep-mid" aria-hidden="true">-</span><a href="#pilates">Pilates</a><span class="sep" aria-hidden="true">-</span><a href="#wellness">Wellbeing</a>
        </nav>
        <div class="countdown" id="countdown" data-target="2026-11-15T08:00:00+00:00">
          <p class="countdown-label">Opening Sunday 15 November</p>
          <div class="countdown-units" aria-hidden="true">
            <div class="unit"><span class="num" data-unit="d">00</span><span class="unit-label">Days</span></div>
            <div class="unit"><span class="num" data-unit="h">00</span><span class="unit-label">Hours</span></div>
            <div class="unit"><span class="num" data-unit="m">00</span><span class="unit-label">Minutes</span></div>
            <div class="unit"><span class="num" data-unit="s">00</span><span class="unit-label">Seconds</span></div>
          </div>
        </div>
        <span class="scroll-cue" aria-hidden="true"></span>
      </section>

      <section class="section" id="about" aria-labelledby="about-title">
        <div class="reveal">
          <h2 class="eyebrow" id="about-title">About</h2>
          <p class="lede">
            A unique concept store bringing together reformer pilates, speciality coffee and food,
            curated homeware, interior design services and wellbeing, including reiki.
          </p>
        </div>
      </section>

      <section class="section" aria-labelledby="offerings-title">
        <h2 class="sr-only" id="offerings-title">What we do</h2>
        <div class="offerings-grid">
          {offerings.map((o, i) => (
            <article class="offering reveal" id={o.id} style={`transition-delay:${i * 120}ms`}>
              <h3>{o.title}</h3>
              <span class="divider" aria-hidden="true"></span>
              <Fragment set:html="<!-- PLACEHOLDER COPY -->" />
              <p>{o.copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section" id="opening-times" aria-labelledby="times-title">
        <div class="times reveal">
          <h2 class="eyebrow" id="times-title">Opening Times</h2>
          <dl>
            {days.map((d) => (
              <div>
                <dt>{d}</dt>
                <dd><time>08.00</time> – <time>18.00</time></dd>
              </div>
            ))}
          </dl>
          <span class="divider" aria-hidden="true"></span>
          <p class="sign-foot">Coffee, Interiors and Wellbeing</p>
        </div>
      </section>

      <section class="section" id="visit" aria-labelledby="visit-title">
        <div class="reveal">
          <h2 class="eyebrow" id="visit-title">Visit</h2>
          <address class="address">
            <span class="name">The Mess Concept</span>
            <span class="muted">37 Otago Street</span>
            <span class="muted">Glasgow G12 8JJ</span>
            <span class="contact">
              <a href={`mailto:${email}`}>{email}</a>
              <a href={`tel:${phoneHref}`}>{phone}</a>
            </span>
          </address>
          <div class="visit-links">
            <a class="text-link" href={directions} target="_blank" rel="noopener noreferrer">
              Get Directions<span class="sr-only"> (opens in a new tab)</span>
            </a>
            <a class="text-link" href={instagram} target="_blank" rel="noopener noreferrer">
              Instagram<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>© The Mess Concept {year}</p>
    </footer>

    <script>
      import Lenis from 'lenis';

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const header = document.getElementById('site-header') as HTMLElement;
      const toggle = document.getElementById('menu-toggle') as HTMLButtonElement;
      const menu = document.getElementById('menu') as HTMLElement;

      // ---- Smooth scroll ----
      let lenis: Lenis | null = null;
      if (!reduced) {
        lenis = new Lenis({ lerp: 0.09, smoothWheel: true });
        const raf = (t: number) => {
          lenis!.raf(t);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }

      const headerOffset = () => header.offsetHeight;

      function scrollToHash(hash: string) {
        const target = hash === '#top' ? document.body : document.querySelector<HTMLElement>(hash);
        if (!target) return;
        if (lenis) {
          // Lenis honours the sections' CSS scroll-margin-top (= header height), so no extra offset here.
          lenis.scrollTo(hash === '#top' ? 0 : target, { duration: 1.4 });
        } else {
          const y = hash === '#top' ? 0 : target.getBoundingClientRect().top + window.scrollY - headerOffset();
          window.scrollTo({ top: y, behavior: 'auto' });
        }
        history.replaceState(null, '', hash === '#top' ? location.pathname : hash);
      }

      // ---- Header state ----
      const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > window.innerHeight * 0.6);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // ---- Menu ----
      let lastFocus: HTMLElement | null = null;
      const focusables = () =>
        Array.from(header.querySelectorAll<HTMLElement>('a[href], button')).filter((el) => !el.closest('[inert]'));

      function setMenu(open: boolean) {
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        menu.classList.toggle('is-open', open);
        header.classList.toggle('is-open', open);
        document.body.classList.toggle('menu-open', open);
        if (open) {
          menu.removeAttribute('inert');
          lenis?.stop();
          lastFocus = document.activeElement as HTMLElement;
          menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
        } else {
          menu.setAttribute('inert', '');
          lenis?.start();
        }
      }

      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        setMenu(open);
        if (!open) (lastFocus ?? toggle).focus({ preventScroll: true });
      });

      document.addEventListener('keydown', (e) => {
        if (toggle.getAttribute('aria-expanded') !== 'true') return;
        if (e.key === 'Escape') {
          setMenu(false);
          toggle.focus({ preventScroll: true });
        } else if (e.key === 'Tab') {
          const els = focusables();
          const first = els[0];
          const last = els[els.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });

      // ---- In-page anchors ----
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
        if (!a) return;
        const hash = a.getAttribute('href')!;
        if (hash === '#main' || hash.length < 2) return; // let the skip link behave natively
        e.preventDefault();
        if (menu.classList.contains('is-open')) setMenu(false);
        scrollToHash(hash);
        const target = document.querySelector<HTMLElement>(hash);
        if (target && hash !== '#top') {
          target.setAttribute('tabindex', '-1');
          target.focus({ preventScroll: true });
        }
      });

      // ---- Opening countdown ----
      const countdown = document.getElementById('countdown');
      if (countdown) {
        const target = new Date(countdown.dataset.target!).getTime();
        const nums = Object.fromEntries(
          Array.from(countdown.querySelectorAll<HTMLElement>('[data-unit]')).map((el) => [el.dataset.unit!, el]),
        );
        const pad = (n: number) => String(n).padStart(2, '0');
        const tick = () => {
          const diff = target - Date.now();
          if (diff <= 0) {
            countdown.classList.add('is-open');
            countdown.querySelector('.countdown-label')!.textContent = 'Now Open';
            return;
          }
          const s = Math.floor(diff / 1000);
          nums.d.textContent = pad(Math.floor(s / 86400));
          nums.h.textContent = pad(Math.floor((s % 86400) / 3600));
          nums.m.textContent = pad(Math.floor((s % 3600) / 60));
          nums.s.textContent = pad(s % 60);
          setTimeout(tick, 1000 - (Date.now() % 1000) + 5);
        };
        tick();
        countdown.classList.add('is-ready');
      }

      // ---- Reveals ----
      const reveals = document.querySelectorAll<HTMLElement>('.reveal');
      if (reduced || !('IntersectionObserver' in window)) {
        reveals.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
        );
        reveals.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
