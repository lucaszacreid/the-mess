---
import { business } from '../data/business';
import { menu, gbp } from '../data/menu';
interface Props { id?: string }
const { id = 'coffee-menu' } = Astro.props;
const review = business.links.googleReview;
---
<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="menu-board reveal">
    <h2 class="eyebrow" id={`${id}-title`}>Menu</h2>
    <div class="menu-cols">
      {menu.map((sec) => (
        <div class="menu-group">
          <h3>{sec.name}</h3>
          <dl>
            {sec.items.map((item) => (
              <div>
                <dt>{item.name}</dt>
                <dd><data value={item.price.toFixed(2)}>{gbp(item.price)}</data></dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </div>
    <span class="divider" aria-hidden="true"></span>
    <p class="sign-foot">Coffee · Interiors · Wellbeing</p>
    {review && (
      <p class="menu-review">
        How was your visit?
        <a class="text-link" href={review} target="_blank" rel="noopener noreferrer">Leave a Google Review</a>
      </p>
    )}
  </div>
</section>
