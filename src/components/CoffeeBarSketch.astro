  <path class="ln o" d="M86,600 L86,546 L140,546 L140,600 Z"/>
  <path class="ln faint" d="M86,546 L94,540 L148,540 L140,546 M148,540 L148,594 L140,600"/>

  <!-- Seated customer facing the table -->
  <g>
    <path class="ln o" d="M100,476 C95,500 95,524 98,546 L134,546 C134,520 132,496 126,476 Q113,466 100,476 Z"/>
    <path class="ln o" d="M102,530 L74,528 L72,544 L102,546 Z"/>
    <path class="ln o" d="M74,530 L70,596 L82,596 L86,544 Z"/>
