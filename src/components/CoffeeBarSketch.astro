---
<figure class="sketch">
  <svg viewBox="0 0 1200 610" role="img" aria-labelledby="sketch-title" preserveAspectRatio="xMidYMid meet">
    <title id="sketch-title">Line drawing of the coffee bar at THE MESS: two baristas at work beneath the wall sign, customers waiting and leaving with THE MESS takeaway cups.</title>
    <defs>
      <!-- Slight wobble so the lines read as hand-drawn rather than ruled -->
      <filter id="sketch-rough" x="-2%" y="-2%" width="104%" height="104%">
        <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="4" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="2.4" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="sketch-rough-2" x="-2%" y="-2%" width="104%" height="104%">
        <feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="2" seed="11" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="4.5" xChannelSelector="G" yChannelSelector="R" />
      </filter>
      <g id="sketch-scene"><Fragment set:html={svg} /></g>
    </defs>
    <!-- Faint second pass, offset, like a pencil going over the line twice -->
    <use href="#sketch-scene" class="sketch-ghost" filter="url(#sketch-rough-2)" transform="translate(1.2 0.8)" />
    <use href="#sketch-scene" filter="url(#sketch-rough)" />
  </svg>
</figure>
