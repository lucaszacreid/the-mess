---
<figure class="sketch">
  <svg viewBox="0 130 1200 480" role="img" aria-labelledby="sketch-title" preserveAspectRatio="xMidYMid meet">
    <title id="sketch-title">Animated line drawing of the coffee bar at THE MESS: baristas making coffee and serving customers, who queue, chat and leave with THE MESS takeaway cups.</title>
    <Fragment set:html={svg} />
  </svg>
</figure>

<script>
  import { startCoffeeBar } from '../scripts/coffee-bar';
