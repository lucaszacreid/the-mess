  <!-- Machine unit (separate cabinet) -->
  <path class="ln o" d="M386,406 L386,600 L546,600 L546,406 Z"/>
  <path class="ln o" d="M382,399 L550,399 L550,406 L382,406 Z"/>
  <path class="ln" d="M396,418 L462,418 L462,588 L396,588 Z M470,418 L536,418 L536,588 L470,588 Z"/>
  <path class="ln" d="M455,496 L455,512 M477,496 L477,512"/>
  <!-- Central compartment -->
  <path class="ln o" d="M550,416 L550,600 L818,600 L818,416 Z"/>
  <path class="ln o" d="M546,408 L822,408 L822,416 L546,416 Z"/>
  <path class="ln faint" d="${flutesFor(562, 416, 810)}"/>
  <!-- Right step -->
  <path class="ln o" d="M820,370 L820,600 L1010,600 L1010,370 Z"/>
  <path class="ln o" d="M814,362 L1016,362 L1016,370 L814,370 Z"/>
  <path class="ln faint" d="${flutesFor(830, 370, 1000)}"/>
  <!-- loose construction strokes, like a pencil sketch -->
  <path class="ln faint" d="M180,362 L198,362 M1016,362 L1040,362 M204,600 L204,612 M378,606 L378,614 M820,606 L820,614 M1010,600 L1010,612 M546,604 L546,612"/>
  <path class="ln faint" d="M210,376 l8,-6 M224,376 l8,-6 M238,376 l8,-6 M836,376 l8,-6 M850,376 l8,-6 M864,376 l8,-6 M556,421 l7,-5 M570,421 l7,-5"/>
