    <path class="ln faint" d="M616,372 Q618,354 636,346"/>
    ${croissant(628, 393)}${croissant(670, 393)}${croissant(649, 384)}
  </g>

  <!-- Takeaway cup stack on the right step -->
  <path class="ln o" d="M980,361 L976,296 L1002,296 L998,361 Z"/>
  <path class="ln faint" d="M978,310 L1000,310 M978,323 L1000,323 M979,336 L999,336 M979,349 L999,349"/>

  ${floorPlant(1140)}

  <!-- Block seating: low cube table and seat cube, scaled to match the standing figures -->
  <g transform="translate(0 600) scale(1.35) translate(0 -600)">
