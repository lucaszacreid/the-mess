    <ellipse class="ln" cx="474" cy="337" rx="16" ry="4.5"/>
    <circle class="ln" cx="440" cy="357" r="5"/><circle class="ln" cx="508" cy="357" r="5"/>
    <path class="ln" d="M402,322 L546,322 M402,322 L402,328 M546,322 L546,328"/>
    ${smallCup(420, 322)}${smallCup(438, 322)}${smallCup(510, 322)}${smallCup(528, 322)}
    <path class="ln" d="M396,326 L392,326 L392,332 M552,326 L556,326 L556,332"/>
    <path class="ln" d="M393,334 L384,372 M555,334 L566,372"/>
    <path class="ln o" d="M432,368 L448,368 L446,376 L434,376 Z M500,368 L516,368 L514,376 L502,376 Z"/>
    <path class="ln" d="M440,376 L418,382 M508,376 L530,382"/>
    <path class="ln faint" d="M437,376 L437,381 M443,376 L443,381 M505,376 L505,381 M511,376 L511,381"/>
    <line class="ln" x1="404" y1="386" x2="544" y2="386"/>
    ${smallCup(440, 386)}${smallCup(508, 386)}
