    <ellipse class="ln o" cx="112" cy="451" rx="12" ry="15"/>
    <path class="ln o" d="M100,452 Q99,436 113,436 Q126,436 124,452 Q120,442 112,443 Q104,444 100,452 Z"/>
    <path class="ln" d="M120,437 Q130,440 128,452"/>
    <path class="ln" d="M106,484 C98,502 96,514 88,512"/>
    <path class="ln" d="M126,486 C132,510 128,526 120,532"/>
  </g>
  ${cup(84, 520, 0.75)}
  </g>

  <!-- Customer one: profile, long coat, sipping -->
  <g transform="translate(244 0)">
    <path class="ln o" d="M-20,488 L-18,592 L-8,592 L-6,488 Z M6,488 L8,592 L18,592 L20,488 Z"/>
    <path class="ln o" d="M-18,592 L-18,600 L-2,600 Q-2,594 -8,592 Z M8,592 L8,600 L26,600 Q26,594 18,592 Z"/>
    <path class="ln o" d="M-8,316 C-30,318 -36,330 -38,356 L-44,490 L40,490 L34,356 C32,330 26,318 8,316 Z"/>
