  ${plant(904, 258)}
  <path class="ln o" d="M950,258 L950,226 L986,226 L986,258 Z"/><path class="ln faint" d="M956,232 L980,232 L980,252 L956,252 Z"/>
  ${jar(1010, 258)}${jar(1034, 258)}${jar(1058, 258)}
  <line class="ln" x1="880" y1="318" x2="1090" y2="318"/>
  <path class="ln faint" d="M898,318 L898,326 M1072,318 L1072,326"/>
  <path class="ln" d="M916,318 L916,312 L952,312 L952,318 M914,312 L954,312 M918,306 L950,306 M914,306 L954,306"/>
  ${bag(990, 318)}${bag(1018, 318)}${bag(1046, 318)}

  <!-- Barista one: behind the La Marzocco -->
  <g>
    <path class="ln o" d="M468,282 C449,284 438,294 434,314 L430,420 L518,420 L514,314 C510,294 499,284 480,282 Z"/>
    <path class="ln" d="M468,274 L468,283 M480,274 L480,283"/>
    <ellipse class="ln o" cx="474" cy="258" rx="14" ry="17"/>
    <path class="ln o" d="M460,258 Q459,240 474,240 Q489,240 488,258 Q484,246 474,246 Q464,247 460,258 Z"/>
    <circle class="ln o" cx="475" cy="235" r="7"/>
    <path class="ln" d="M462,296 L456,330 M486,296 L492,330"/>
    <path class="ln" d="M514,316 C526,330 540,338 556,336"/>
    <path class="ln" d="M434,316 C424,334 420,346 428,354"/>
  </g>

  <!-- Barista two: handing over a takeaway cup -->
  <g>
    <path class="ln o" d="M754,282 C732,284 722,294 718,316 L714,420 L806,420 L802,316 C798,294 788,284 766,282 Z"/>
    <path class="ln" d="M754,274 L754,283 M766,274 L766,283"/>
    <ellipse class="ln o" cx="760" cy="257" rx="14" ry="17"/>
    <path class="ln o" d="M746,254 Q746,236 762,236 Q777,237 775,254 Q770,244 758,245 Q750,246 746,254 Z"/>
    <path class="ln" d="M744,300 L738,330 L782,330 L776,300"/>
    <path class="ln" d="M738,330 L736,410 M782,330 L784,410"/>
    <path class="ln faint" d="M748,356 L772,356 L772,376 L748,376 Z"/>
    <path class="ln" d="M800,312 C812,326 818,336 822,340 L848,336"/>
    <ellipse class="ln o" cx="852" cy="335" rx="5" ry="4"/>
  </g>
  ${cup(858, 343)}

  <!-- Bar: raised step left, machine unit, central compartment, raised step right -->
  <!-- Left step -->
  <path class="ln o" d="M204,370 L204,600 L378,600 L378,370 Z"/>
  <path class="ln o" d="M198,362 L384,362 L384,370 L198,370 Z"/>
